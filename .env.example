# Copy this file as .env and fill in the values, the .env file is never committed to the repository
# Docker Compose reads the .env file, to run the application define the same variables in the environment or in
# the run configuration of the IDE

# Database (docker-compose.yml and application.yaml), if they are not defined these values are used
DB_NAME=campus_db
DB_USERNAME=campus_user
DB_PASSWORD=campus_password
DB_URL=jdbc:postgresql://localhost:5432/campus_db

# JWT issuance (3_jwt-spec.md), if JWT_PRIVATE_KEY is left empty an ephemeral key is generated for development only
JWT_PRIVATE_KEY=
JWT_KEY_ID=ms01-2026-01

# Internal calls to MS08 through the API Gateway
GATEWAY_URL=
GATEWAY_SERVICE_KEY=

# Services authorized for the internal routes (RF-MS01-09), separated by commas
INTERNAL_ALLOWED_SERVICES=ms03,ms04,ms05

# Institutional email domains allowed in the registration, without the at sign and separated by commas
INSTITUTIONAL_EMAIL_DOMAINS=escuelaing.edu.co,mail.escuelaing.edu.co

# First administrator, if they are left empty none is created
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_FIRST_NAME=
BOOTSTRAP_ADMIN_LAST_NAME=

# Password recovery (RF-MS01-08), validity of the code in minutes, failed attempts allowed per code
# and wait in seconds between two codes of the same user (0 disables the wait)
RECOVERY_CODE_TTL_MINUTES=15
RECOVERY_MAX_ATTEMPTS=5
RECOVERY_RESEND_COOLDOWN_SECONDS=60

# Mail server that sends the recovery code: Gmail with the account of the project (STARTTLS on 587).
# MAIL_PASSWORD is a Google application password (16 characters, created in the account with the verification in
# 2 steps active: Google Account > Security > App passwords), not the password of the account.
# To test without sending real emails the Mailpit of the docker-compose can be used: MAIL_HOST=localhost, MAIL_PORT=1025,
# MAIL_SMTP_AUTH=false, MAIL_SMTP_STARTTLS=false (inbox at http://localhost:8025)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=proyectometx@gmail.com
MAIL_PASSWORD=
MAIL_SMTP_AUTH=true
MAIL_SMTP_STARTTLS=true
MAIL_FROM=CampusSeguro <proyectometx@gmail.com>

# Swagger only in local development
SWAGGER_ENABLED=false