# ---------------------------------------------------------------------------
# MS01 - Identity and Access (MVP, Fase 1)
# Copia este archivo a .env y ajusta los valores segun tu entorno.
# ---------------------------------------------------------------------------

# PostgreSQL
DB_URL=jdbc:postgresql://localhost:5432/campusseguro_db
DB_USER=campus_user
DB_PASSWORD=campus_password

# Aplicacion
SERVER_PORT=8081
SPRING_PROFILES_ACTIVE=dev
JPA_SHOW_SQL=false

# ---------------------------------------------------------------------------
# Fase 2 (no requerido en el MVP): seguridad JWT
# JWT_SECRET=change-me-in-prod
# JWT_EXPIRATION_MS=3600000
# JWT_ISSUER=ms01-identity-access
# ---------------------------------------------------------------------------