# Copie este archivo como .env y complete los valores, el archivo .env nunca se sube al repositorio
# Docker Compose lee el archivo .env, para ejecutar la aplicación defina las mismas variables en el entorno o en
# la configuración de ejecución del IDE

# Base de datos (docker-compose.yml y application.yaml), si no se definen se usan estos valores
DB_NAME=campus_db
DB_USERNAME=campus_user
DB_PASSWORD=campus_password
DB_URL=jdbc:postgresql://localhost:5432/campus_db

# Emisión de JWT (3_jwt-spec.md), si JWT_PRIVATE_KEY queda vacía se genera una llave efímera solo para desarrollo
JWT_PRIVATE_KEY=
JWT_KEY_ID=ms01-2026-01

# Llamadas internas hacia MS08 a través del API Gateway
GATEWAY_URL=
GATEWAY_SERVICE_KEY=

# Dominios de correo institucional permitidos en el registro, sin la arroba y separados por comas
INSTITUTIONAL_EMAIL_DOMAINS=escuelaing.edu.co,mail.escuelaing.edu.co

# Primer administrador, si quedan vacías no se crea ninguno
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_FIRST_NAME=
BOOTSTRAP_ADMIN_LAST_NAME=

# Recuperación de contraseña (RF-MS01-08), vigencia del código en minutos, intentos fallidos permitidos por código
# y espera en segundos entre dos códigos del mismo usuario (0 desactiva la espera)
RECOVERY_CODE_TTL_MINUTES=15
RECOVERY_MAX_ATTEMPTS=5
RECOVERY_RESEND_COOLDOWN_SECONDS=60

# Servidor de correo SMTP que envía el código de recuperación, en desarrollo local se usa Mailpit del
# docker-compose (SMTP en el puerto 1025 y bandeja web en http://localhost:8025), en producción se definen el
# servidor institucional y sus credenciales
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SMTP_AUTH=false
MAIL_SMTP_STARTTLS=false
MAIL_FROM=no-reply@campusseguro.local

# Swagger solo en desarrollo local
SWAGGER_ENABLED=false